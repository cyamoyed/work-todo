{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkTodo",
  "version": "0.1.0",
  "identifier": "com.worktodo.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node ../scripts/prepare-dist.js",
    "beforeBuildCommand": "node ../scripts/prepare-dist.js"
  },
  "app": {
    "windows": [
      {
        "title": "工作待办 · WorkTodo",
        "width": 1100,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "工作待办",
    "longDescription": "轻量工作待办任务管理",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
