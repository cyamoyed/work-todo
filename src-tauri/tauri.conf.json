{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "work-todo",
  "identifier": "com.work-todo.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "工作待办 · work-todo",
        "width": 1100,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "工作待办",
    "longDescription": "轻量工作待办任务管理",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cyamoyed/work-todo/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEQ0Q2OTA0Q0JCQTA5RDMKUldUVENickxCR25OTFVNYXNWWnE5WFFEeFRLeVJIUmdxZGtTVWpjVWYvUkZNTlR3cHA3MFVkeG4K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
